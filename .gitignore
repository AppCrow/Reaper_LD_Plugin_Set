.DS_Store

# REAPER regenerates these from the audio
*.reapeaks
peaks/

# built by build-package.sh, rebuildable at any time
dist/

# video build intermediates (slides, per-scene clips) — rebuildable
Tutorials/video/work/

# internal cross-agent memory — local only, not for the public repo
AGENTS.md

# a combined all-guides PDF kept locally; the per-plugin PDFs ship instead
Steelblue_Reaper_LD_Plugin_Set.pdf

# conductor handover for the next build stage — local only, never public
UEBERGABE.md
REPORT-phase-*.md

# REAPER auto-backups next to saved projects
Backups/
*.rpp-bak

# Tobi's drop folder for incoming files (icons etc.) and the Finder folder-icon resource
Input/
Icon

